configuration {
	// modi: "drun,window,ssh";
	modi: "drun,calc";
	lines: 10;
	font: "sans-serif 12";
	bw: 0;
	padding: 0;
	show-icons: true;
	terminal: "kitty";
	matching: "glob";
	line-margin: 0;
	line-padding: 10;
	separator-style: "none";
	hide-scrollbar: true;
	sort: true;
}

@theme "themes/custom-nord.rasi"
