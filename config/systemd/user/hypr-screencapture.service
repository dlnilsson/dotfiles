[Unit]
Description=Monitor Hyprland screencapture (writes ON|OFF)
PartOf=graphical-session.target
Requires=graphical-session.target
After=graphical-session.target
# Only start if we're in a Wayland/Hyprland session
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
Type=simple
# Use your GOPATH bin (adjust if different)
ExecStart=%h/go/bin/hypr-screencapture
Slice=session.slice
Restart=on-failure
RestartSec=1
# Ensure the unit sees the session’s IPC env
PassEnvironment=WAYLAND_DISPLAY XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE

[Install]
WantedBy=graphical-session.target
