// Shared bar layout and modules live in bar.jsonc.
[
    {
        // Built-in laptop screen: use full width
        "output": "eDP-1",
        "include": ["~/.config/waybar/bar.jsonc"]
    },
    {
        // External monitors: 2560px (16:9 at 1440p) centered bar
        "output": "!eDP-1",
        "width": 2525,
        "include": ["~/.config/waybar/bar.jsonc"]
    }
]
