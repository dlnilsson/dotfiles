#!/usr/bin/env bash

BAT="/org/freedesktop/UPower/devices/battery_BAT0"
info="$(upower -i "$BAT")"

percent=$(grep -Po 'percentage:\s+\K[0-9]+' <<<"$info")
state=$(grep -Po 'state:\s+\K.*' <<<"$info")
icon_name=$(grep -Po "icon-name:\s+'*\K[^']+" <<<"$info")

case "$icon_name" in
  *full-charged*|*full*)    glyph="" ;;
  *good*|*80*)              glyph="" ;;
  *60*)                     glyph="" ;;
  *40*)                     glyph="" ;;
  *caution*|*20*|*low*)     glyph="" ;;
  *charging*)               glyph="" ;;
  *)                        glyph="" ;;
esac

color="#D8DEE9"
if [[ "$state" == "charging" ]]; then
  color="#88C0D0"
elif (( percent <= 20 )); then
  color="#D08770"
fi

echo "<span foreground='$color'>$glyph $percent% ($state)</span>"
wlan=$(cat /sys/class/net/wlan0/operstate | tr -d '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | tr '[:lower:]' '[:upper:]')

# Usage:
#   echo "$(wifi_strength)"        # defaults to wlan0
#   echo "$(wifi_strength wlp2s0)" # specific interface
wifi_strength() {
  local ifname="${1:-wlan0}"
  local rssi pct bars

  rssi="$(iw dev "$ifname" link 2>/dev/null | awk '/signal:/ {print $2; exit}')"
  [[ -n "$rssi" ]] || { echo "󰤭 0%"; return 1; }  # nf-md-wifi_off

  pct=$(( 2 * (rssi + 100) ))
  (( pct < 0 )) && pct=0
  (( pct > 100 )) && pct=100

  # Nerd Font Material Design Wi-Fi icons (off -> full)
  if   (( pct >= 80 )); then bars="󰤨"  # wifi_strength_4
  elif (( pct >= 60 )); then bars="󰤥"  # wifi_strength_3
  elif (( pct >= 40 )); then bars="󰤢"  # wifi_strength_2
  elif (( pct >= 20 )); then bars="󰤟"  # wifi_strength_1
  else                    bars="󰤯"  # wifi_strength_outline
  fi

  echo -e "$bars   ${pct}%"
}

echo "<span>WLAN0 $wlan  $(wifi_strength)</span>"

