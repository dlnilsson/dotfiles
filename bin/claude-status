#!/usr/bin/env python3
"""Print a Waybar status for Claude Code sessions waiting on a person."""

import json
import os
from pathlib import Path


def main():
    claude_home = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
    counts = {"CLI": 0, "Zed": 0}
    waiting = []

    # Claude Code keeps one status file per running session, CLI and SDK alike.
    for session_file in (claude_home / "sessions").glob("*.json"):
        try:
            state = json.loads(session_file.read_text())
            stat = Path(f"/proc/{state['pid']}/stat").read_text()
            if stat.rsplit(") ", 1)[1].split()[19] != state["procStart"]:
                continue  # The file outlived its session and the pid was reused.
            if state["status"] != "waiting":
                continue
        except (OSError, ValueError, KeyError, IndexError, TypeError):
            continue
        counts["CLI" if state.get("entrypoint") == "cli" else "Zed"] += 1
        waiting.append(f"{state.get('name', state['pid'])}: {state.get('waitingFor', 'waiting')}")

    pending = sum(counts.values())
    if pending:
        sources = ", ".join(f"{name}: {count}" for name, count in counts.items() if count)
        status_class = "action-required"
        tooltip = "\n".join([f"Action required ({sources})", *sorted(waiting)])
    else:
        status_class = "idle"
        tooltip = "Claude: no action required"

    print(json.dumps({
        "text": f"Claude: {pending}" if pending else "",
        "class": status_class,
        "tooltip": tooltip,
    }))


if __name__ == "__main__":
    main()
