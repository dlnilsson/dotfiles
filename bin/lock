#!/usr/bin/env sh
# xdotool key XF86AudioMute &&
# betterlockscreen -l dim &> /dev/null
set -uo pipefail

bw lock &> /dev/null &

HYPRLOCK_BIN="${HYPRLOCK_BIN:-hyprlock}"
SWAYLOCK_BIN="${SWAYLOCK_BIN:-swaylock}"

run_cmd() {
  local cmd="$1"; shift
  if command -v "$cmd" >/dev/null 2>&1; then
    "$cmd" "$@"
    return $?
  else
    # command not found is considered failure to allow fallback
    return 127
  fi
}

if run_cmd "$HYPRLOCK_BIN" "$@"; then
  exit 0
fi


if run_cmd "$SWAYLOCK_BIN" "$@"; then
  exit 0
fi

echo "Error: neither '$HYPRLOCK_BIN' nor '$SWAYLOCK_BIN' succeeded." >&2
exit 1
