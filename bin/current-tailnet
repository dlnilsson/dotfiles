#!/bin/bash


tn=$(tailscale status --json | jq -r .CurrentTailnet.Name)
if [[ "$tn" =~ "daniel" ]]; then
    exitNode=$(tailscale status --json | jq '.ExitNodeStatus')
    if [[ "$exitNode" != "null" ]]; then
        node=$(tailscale status --json | jq -r '.Peer[] | select(.ID=="nE45gbocWi11CNTRL") | .HostName')
        echo -e "\uf192 home - exitnode: $node"
        exit
    fi
    echo -e '\uf192  home'
else
    echo -e '\uf10c  work'
fi

