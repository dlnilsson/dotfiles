#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

DEV="/org/freedesktop/UPower/devices/battery_BAT0"
COOLDOWN_SECS=15
last_notify_time=0

get_state() {
    upower -i "$DEV" | grep -Po 'state:\s+\K.*' 2>/dev/null || true
}

get_icon() {
    local icon
    icon="$(upower -i "$DEV" | grep -Po "icon-name:\s+'*\K[^']+" 2>/dev/null || true)"
    echo "${icon:-battery-symbolic}"
}

state_to_mode() {
    case "$1" in
        charging|fully-charged|pending-charge) echo "ac" ;;
        *) echo "bat" ;;
    esac
}

cooldown_passed() {
    local now
    now="$(date +%s)"
    (( now - last_notify_time >= COOLDOWN_SECS ))
}

send_notify() {
    if cooldown_passed; then
        notify-send "$@"
        last_notify_time="$(date +%s)"
    fi
}

set_decorations() {
    "$(dirname "$0")/power_saver" "$1"
}

state="$(get_state)"
if [[ -z "$state" ]]; then
    notify-send --expire-time=3000 --transient "Power" "Failed to read battery state"
    exit 1
fi

mode="$(state_to_mode "$state")"
last_mode="$mode"

icon="$(get_icon)"
set_decorations "$([[ "$mode" == "bat" ]] && echo true || echo false)"
notify-send -i "$icon" --expire-time=3000 --transient "Power" "Charger is $([[ "$mode" == "ac" ]] && echo connected || echo disconnected)"
last_notify_time="$(date +%s)"

dbus-monitor --system \
    "type='signal',sender='org.freedesktop.UPower',interface='org.freedesktop.DBus.Properties',path='$DEV',member='PropertiesChanged'" \
    | while read -r line; do
        [[ "$line" != *'"State"'* ]] && continue

        state="$(get_state)"
        [[ -z "$state" ]] && continue

        mode="$(state_to_mode "$state")"
        [[ "$mode" == "$last_mode" ]] && continue

        icon="$(get_icon)"
        set_decorations "$([[ "$mode" == "bat" ]] && echo true || echo false)"
        send_notify -i "$icon" --expire-time=3000 --transient "Power" "Charger $([[ "$mode" == "ac" ]] && echo connected || echo disconnected)"
        last_mode="$mode"
    done
