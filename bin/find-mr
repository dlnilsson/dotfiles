#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 || ! $1 =~ ^[[:xdigit:]]{7,40}$ ]]; then
  printf 'Usage: find-mr <commit-sha>\n' >&2
  exit 2
fi

if ! project=$(glab repo view --output json 2>/dev/null | jq -r '.path_with_namespace // empty'); then
  printf 'find-mr: could not resolve the current GitLab repository\n' >&2
  exit 1
fi
if [[ -z $project ]]; then
  printf 'find-mr: current GitLab repository has no path_with_namespace\n' >&2
  exit 1
fi

encoded_project=$(jq -nr --arg project "$project" '$project | @uri')
glab api "projects/$encoded_project/repository/commits/$1/merge_requests" |
  jq -r '.[] | "\(.reference)\t\(.title)\t\(.web_url)"'
