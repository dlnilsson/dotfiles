#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/power_saver_state"

set_kitty_opacity() {
    local opacity="$1"
    for socket in /tmp/kitty-*; do
        kitty @ --to "unix:$socket" set-background-opacity --all "$opacity" 2>/dev/null || true
    done
    sed -i "s/^background_opacity.*/background_opacity $opacity/" ~/.config/kitty/background.conf
}

set_zed_background() {
    local settings="$HOME/.config/zed/settings.json"
    [[ -f "$settings" ]] || return 0
    # Write in place: sed -i swaps the inode and Zed stops watching the file
    # (https://github.com/zed-industries/zed/issues/65270).
    local updated
    updated="$(sed "s/\"background.appearance\": \"[a-z]*\"/\"background.appearance\": \"$1\"/" "$settings")"
    printf '%s\n' "$updated" > "$settings"
}

set_noctalia_animations() {
    local dropin="$HOME/.config/noctalia/power_saver.toml"
    if [[ "$1" == "off" ]]; then
        cat > "$dropin" <<'EOF'
[shell]
offline_mode = true
popup_shadows = false

[shell.animation]
enabled = false

[shell.panel]
transparency_mode = "solid"
shadow = false

[backdrop]
enabled = false

[wallpaper]
transition_duration = 0
EOF
    else
        rm -f "$dropin"
    fi
    noctalia msg config-reload &>/dev/null || true
}

get_status() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        echo "performance"
    fi
}

case "${1:-}" in
    --status)
        mode="$(get_status)"
        case "$mode" in
            performance) printf '{"text":"\uf0e7","alt":"performance","tooltip":"performance","class":"performance","percentage":100}\n' ;;
            powersave)   printf '{"text":"\uf06c","alt":"powersave","tooltip":"powersave","class":"powersave","percentage":0}\n' ;;
            *)           printf '{"text":"?","alt":"unknown","tooltip":"unknown","class":"unknown","percentage":0}\n' ;;
        esac
        exit 0
        ;;
    --toggle)
        if [[ "$(get_status)" == "powersave" ]]; then
            set -- false
			noctalia msg notification-show "performance"
        else
            set -- true
			noctalia msg notification-show "powersave"
        fi
        ;;
esac

enabled="${1:-true}"

if [[ "$enabled" == "true" ]]; then
    hyprctl eval '
        hl.config({
            decoration = { blur = { enabled = false }, rounding = 0, shadow = { enabled = false } },
            general    = { gaps_out = 0, gaps_in = 0, border_size = 0 },
            animations = { enabled = false },
        })
    ' &>/dev/null || true
    set_kitty_opacity 1
    set_zed_background opaque
    set_noctalia_animations off
    for cpu in /sys/devices/system/cpu/cpu[0-9]*; do
        echo "powersave" > "$cpu/cpufreq/scaling_governor"
    done
    echo "powersave" > "$STATE_FILE"
	batch="$(hyprctl clients -j 2>/dev/null | jq -r '.[].address | "dispatch setprop address:\(.) rounding 0"' | paste -sd';' -)"
	[[ -n "$batch" ]] && hyprctl --batch "$batch" &>/dev/null || true
else
    hyprctl eval '
        hl.config({
            decoration = { blur = { enabled = true }, rounding = 10, shadow = { enabled = true } },
            general    = { gaps_out = 10, gaps_in = 5, border_size = 2 },
            animations = { enabled = true },
        })
    ' &>/dev/null || true
    set_kitty_opacity 0.75
    set_zed_background blurred
    set_noctalia_animations on
    for cpu in /sys/devices/system/cpu/cpu[0-9]*; do
        echo "performance" > "$cpu/cpufreq/scaling_governor"
    done
    echo "performance" > "$STATE_FILE"
	batch="$(hyprctl clients -j 2>/dev/null | jq -r '.[].address | "dispatch setprop address:\(.) rounding 10"' | paste -sd';' -)"
	[[ -n "$batch" ]] && hyprctl --batch "$batch" &>/dev/null || true
fi

opaque="$([[ "$enabled" == "true" ]] && echo 1 || echo 0)"
batch="$(hyprctl clients -j 2>/dev/null | jq -r --arg opaque "$opaque" '.[].address | "dispatch setprop address:\(.) opaque \($opaque)"' | paste -sd';' -)"
[[ -n "$batch" ]] && hyprctl --batch "$batch" &>/dev/null || true
