#!/usr/bin/env bash
# See: https://bobbys.zone/guides/hyprland-clamshell

# Reload Hyprland if only the built-in panel is active to re-apply monitor keywords cleanly.
maybe_reload_single_default() {
  if hyprctl monitors all -j | jq -e '
    [.[] | select(.disabled != true)] as $enabled
    | $enabled
    | select(length == 1)
    | .[0]
    | select(.name == "eDP-1")
  ' >/dev/null; then
    hyprctl reload
  fi
}


external=$(hyprctl monitors -j | jq -r '.[] | select(.name | test("^DP-[0-9]+"))')

if [[ -n "$external" ]]; then
  if [[ $1 == "open" ]]; then
    hyprctl keyword monitor "eDP-1,highres,auto,1"
    maybe_reload_single_default
  else
    hyprctl keyword monitor "eDP-1,disable"
    res=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | "\(.width)x\(.height) at \(.refreshRate | floor)hz"')
    notify-send --transient "Running external" "$res" --expire-time=3000
  fi
else
  hyprctl keyword monitor "eDP-1,highres,auto,1"
  sleep 1
  res=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | "\(.width)x\(.height) at \(.refreshRate | floor)hz"')
  notify-send --transient "No external monitor detected" "running $res" --expire-time=3000
fi
