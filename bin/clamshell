#!/usr/bin/env bash
# See: https://bobbys.zone/guides/hyprland-clamshell


external=$(hyprctl monitors -j | jq -r '.[] | select(.name | test("^DP-[0-9]+"))')

if [[ -n "$external" ]]; then
  if [[ $1 == "open" ]]; then
    best_mode=$(echo "$external" | jq -r '.availableModes[0]')
    hyprctl keyword monitor "eDP-1,${best_mode},0x0,1"
  else
    hyprctl keyword monitor "eDP-1,disable"
  fi
fi
