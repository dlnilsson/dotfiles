#!/usr/bin/env bash
set -euo pipefail

if [[ $# != 2 || ! $1 =~ ^(add|remove)$ || ! $2 =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "Usage: $0 add|remove <source>" >&2
    exit 1
fi

state_dir="${XDG_RUNTIME_DIR:?}/noctalia-notification-inhibit"
mkdir -p "$state_dir"
exec 9>"$state_dir/lock"
flock 9
shopt -s nullglob
sources=("$state_dir"/source-*)

if [[ $1 == add ]]; then
    if [[ ${#sources[@]} == 0 && ! -f $state_dir/previous ]]; then
        previous=$(noctalia msg notification-dnd-status)
        case "$previous" in
            on|off) printf '%s\n' "$previous" > "$state_dir/previous" ;;
            *) echo "Unexpected Noctalia DND state: $previous" >&2; exit 1 ;;
        esac
    fi
    noctalia msg notification-dnd-set on
    touch "$state_dir/source-$2"
else
    rm -f "$state_dir/source-$2"
    sources=("$state_dir"/source-*)
    if [[ ${#sources[@]} == 0 && -f $state_dir/previous ]]; then
        noctalia msg notification-dnd-set "$(cat "$state_dir/previous")"
        rm "$state_dir/previous"
    fi
fi
