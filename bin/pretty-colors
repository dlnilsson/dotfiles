#!/bin/bash
#  https://github.com/Blacksuan19/Scripts/blob/d40f9fdb1562cbe3edfe40f53979fceaf90120d7/colors.sh
#   This file echoes a bunch of color codes to the
#   terminal to demonstrate what's available.  Each
#   line is the color code of one forground color,
#   out of 17 (default + 16 escapes), followed by a
#   test use of that color on all nine background
#   colors (default + 8 escapes).
#

T='gYw'   # The test text

echo -e "\n                 40m     41m     42m     43m\
	44m     45m     46m     47m";

for FGs in '    m' '   1m' '  30m' '1;30m' '  31m' '1;31m' '  32m' \
	'1;32m' '  33m' '1;33m' '  34m' '1;34m' '  35m' '1;35m' \
	'  36m' '1;36m' '  37m' '1;37m';
  do FG=${FGs// /}
	  echo -en " $FGs \033[$FG  $T  "
	  for BG in 40m 41m 42m 43m 44m 45m 46m 47m;
	  do echo -en "$EINS \033[$FG\033[$BG  $T  \033[0m";
	  done
	  echo;
  done
  echo

echo "==============="
echo "Test unicode characters"
echo "==============="
echo -e '\U0001f602'
printf '\xE2\x98\xA0\n'
echo "==============="

# https://stackoverflow.com/a/16509364
fast_chr() {
  local __octal
  local __char
  printf -v __octal '%03o' $1
  printf -v __char \\$__octal
  REPLY=$__char
}

unichr() {
  local c=$1    # Ordinal of char
  local l=0    # Byte ctr
  local o=63    # Ceiling
  local p=128    # Accum. bits
  local s=''    # Output string

  (( c < 0x80 )) && { fast_chr "$c"; echo -n "$REPLY"; return; }

  while (( c > o )); do
      fast_chr $(( t = 0x80 | c & 0x3f ))
      s="$REPLY$s"
      (( c >>= 6, l++, p += o+1, o>>=1 ))
  done

  fast_chr $(( t = p | c ))
  echo -n "$REPLY$s"
}

echo
echo "=== Test harness unichr ==="
## test harness
for (( i=0x2500; i<0x2600; i++ )); do
  unichr $i
done
echo
echo "=============================="
echo


echo
echo "=== Test custom terminal text size ==="
echo "Test terminal text size"
echo "should be double"
printf "\e]66;s=2;Double sized text\a\n\n"
echo "should be tripple"
printf "\e]66;s=3;Triple sized text\a\n\n\n"
echo "should be half size"
printf "\e]66;n=1:d=2;Half sized text\a\n"
echo "=============================="
echo

# Font Awesome Unicode codepoints (v6 free set: solid + brands)
declare -A icons=(
  # Brands
  ["fa-github"]="\uf09b"
  ["fa-docker"]="\uf395"
  ["fa-linux"]="\uf17c"
  ["fa-apple"]="\uf179"
  ["fa-windows"]="\uf17a"
  ["fa-twitter"]="\uf099"
  ["fa-facebook"]="\uf09a"
  ["fa-youtube"]="\uf167"
  ["fa-discord"]="\uf392"
  ["fa-gitlab"]="\uf296"

  # UI / Actions
  ["fa-user"]="\uf007"
  ["fa-users"]="\uf0c0"
  ["fa-user-plus"]="\uf234"
  ["fa-lock"]="\uf023"
  ["fa-unlock"]="\uf09c"
  ["fa-cog"]="\uf013"
  ["fa-search"]="\uf002"
  ["fa-download"]="\uf019"
  ["fa-upload"]="\uf093"
  ["fa-trash"]="\uf1f8"
  ["fa-edit"]="\uf044"
  ["fa-check"]="\uf00c"
  ["fa-times"]="\uf00d"
  ["fa-plus"]="\uf067"
  ["fa-minus"]="\uf068"

  # System / Files
  ["fa-home"]="\uf015"
  ["fa-folder"]="\uf07b"
  ["fa-folder-open"]="\uf07c"
  ["fa-file"]="\uf15b"
  ["fa-file-alt"]="\uf15c"
  ["fa-save"]="\uf0c7"
  ["fa-print"]="\uf02f"

  # Media
  ["fa-play"]="\uf04b"
  ["fa-pause"]="\uf04c"
  ["fa-stop"]="\uf04d"
  ["fa-forward"]="\uf04e"
  ["fa-backward"]="\uf04a"
  ["fa-volume-up"]="\uf028"
  ["fa-volume-mute"]="\uf6a9"
  ["fa-camera"]="\uf030"
  ["fa-image"]="\uf03e"
  ["fa-video"]="\uf03d"

  # Misc
  ["fa-heart"]="\uf004"
  ["fa-star"]="\uf005"
  ["fa-bell"]="\uf0f3"
  ["fa-calendar"]="\uf133"
  ["fa-envelope"]="\uf0e0"
  ["fa-globe"]="\uf0ac"
  ["fa-shopping-cart"]="\uf07a"
)

echo "=== Font Awesome Icon Test ==="
for name in "${!icons[@]}"; do
  icon=$(printf "%b" "${icons[$name]}")
  # Detect missing glyphs (tofu box, ?, or empty)
  if [[ "$icon" == "□" || "$icon" == "?" || -z "$icon" ]]; then
    printf "%-18s %s [MISSING]\n" "$name" "$icon"
  else
    printf "%-18s %s\n" "$name" "$icon"
  fi
done | sort
echo "=============================="

